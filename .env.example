# MongoDB — use a dedicated database (not shared app DBs)
MONGODB_URI=mongodb+srv://portfolio:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?appName=Cluster0

# Admin dashboard login (change in production)
ADMIN_PASSWORD=change-me-to-a-strong-password

# JWT signing secret — generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public site
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Contact form (Resend) — https://resend.com
# Create API key, then verify imtiaztamim.com domain for production FROM address
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Required in Resend test mode (until domain verified): your Resend signup email
CONTACT_TO_EMAIL=your-resend-signup@gmail.com
# After domain verify:
# CONTACT_TO_EMAIL=hello@imtiaztamim.com
# CONTACT_FROM_EMAIL=Imtiaz Tamim <hello@imtiaztamim.com>

# Cloudinary (admin image upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
