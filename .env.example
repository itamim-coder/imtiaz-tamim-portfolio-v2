# MongoDB — use a dedicated database (not shared app DBs)
MONGODB_URI=mongodb+srv://portfolio:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?appName=Cluster0

# Admin dashboard login (change in production)
ADMIN_PASSWORD=change-me-to-a-strong-password

# JWT signing secret — generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public site
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username
